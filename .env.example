# Copy to .env and adjust. Never commit .env (it is git-ignored).

# ---- Apps ----
# Apps are auto-discovered from app-model/<app>/app.json (each has its own baseURL).
# BASE_URL overrides the FIRST app only — handy for pointing the POC at a staging URL.
# BASE_URL=https://the-internet.herokuapp.com

# Default app tag for CSV rows / prompts that omit an `App` column:
APP=theinternet


# ---- LLM provider (swappable) ----
# Which model runs the fuzzy stages (normalize / generate / analyze).
# One of: claude | openai | copilot | mock   (default: mock — offline, no key)
LLM_PROVIDER=mock

# Claude (Anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (ChatGPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Copilot (via GitHub Models, OpenAI-compatible)
# GITHUB_MODELS_TOKEN=ghp_...
# COPILOT_MODEL=gpt-4o
# COPILOT_BASE_URL=https://models.inference.ai.azure.com

# ---- Xray Cloud (Jira) ----
# Jira > Apps > Xray > Settings > API Keys. Keep real values in .env only.
# XRAY_CLIENT_ID=
# XRAY_CLIENT_SECRET=
# US (default) https://xray.cloud.getxray.app | EU https://eu.xray.cloud.getxray.app | AU https://au.xray.cloud.getxray.app
# XRAY_BASE_URL=https://xray.cloud.getxray.app
# XRAY_JQL=project = ABC AND issuetype = Test
