          <mxGeometry x="120" y="100" width="150" height="32" as="geometry" />
        </mxCell>

        <!-- ===== Pipeline spine ===== -->
        <mxCell id="n_ing" value="L1 · Ingestion and Adapters&#10;XrayAdapter · CsvAdapter · PromptAdapter → raw intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ef;strokeColor=#0d7680;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="168" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_ir" value="L2 · Normalization → Test Case IR  (LLM)&#10;canonical schema (+ Xray key, steps, preconditions); clarify if ambiguous" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ddf8;strokeColor=#6d4bd1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="252" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_grnd" value="L3 · App Grounding — Playwright MCP&#10;live a11y snapshot + codebase → Page Objects + selector map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ef;strokeColor=#0d7680;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="336" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_gen" value="L4 · Script Generation  (LLM)&#10;IR + grounded POM + standards → TS spec; ≥1 tagged assert per expected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ddf8;strokeColor=#6d4bd1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="420" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_exec" value="L5 · Execution&#10;playwright test · trace / screenshot / video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0df;strokeColor=#1f8f4e;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="504" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_heal" value="L6 · Analysis and Self-heal  (LLM)&#10;classify → fix cause; retry ≤3; guarded (no weakening); app-bug = STOP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde4d1;strokeColor=#c2560b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="588" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_rev" value="L7 · Human Review Gate&#10;reviewer approves generated spec (PR) before merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="672" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_rep" value="L8 · Reporting and Migration Dashboard&#10;per-case status + reason · throughput · unedited pass-rate · coverage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f0ef;strokeColor=#0d7680;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="756" width="290" height="52" as="geometry" />
        </mxCell>
        <mxCell id="n_out" value="OUTPUTS&#10;tests/*.spec.ts (git PR) · traceability matrix · report.md/html · traces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="840" width="290" height="52" as="geometry" />
        </mxCell>

        <!-- ===== Side: App Model Registry ===== -->
        <mxCell id="n_pom" value="App Model Registry&#10;Page Object + selector library (grounded once, reused across many tests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="336" width="200" height="72" as="geometry" />
        </mxCell>

        <!-- ===== Side: Migration Ledger (the migration backbone) ===== -->
        <mxCell id="n_ledger" value="MIGRATION LEDGER and TRACEABILITY&#10;&#10;Xray key ↔ IR ↔ spec path ↔ run status&#10;&#10;state: migrated / needs-review / failed / blocked&#10;&#10;idempotent batch re-runs&#10;coverage % vs. Xray repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=top;spacingTop=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="252" width="220" height="472" as="geometry" />
        </mxCell>

        <!-- ===== Verification gate (deterministic) ===== -->
        <mxCell id="n_verify" value="VERIFICATION GATE  (deterministic)&#10;every expected result has a tagged assertion;&#10;rejects vacuous / weak / untraced tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="462" width="220" height="56" as="geometry" />
