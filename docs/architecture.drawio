        <mxCell id="e_v1" value="must pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;dashed=1;fontSize=9;" edge="1" parent="1" source="n_gen" target="n_verify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_v2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="n_verify" target="n_exec"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Swappable LLM provider ===== -->
        <mxCell id="n_llm" value="LLM PROVIDER  (swappable)&#10;Claude · ChatGPT · Copilot&#10;one interface — held to the same gates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ddf8;strokeColor=#6d4bd1;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
