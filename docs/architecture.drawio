  <diagram name="Migration Architecture" id="xray-pw-migration">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Title + legend ===== -->
        <mxCell id="title" value="Xray → Playwright Test Migration Agent" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Teal = deterministic code   •   Purple = LLM (AI)   •   Green = execution   •   Yellow = human gate   •   Blue = traceability   •   Grey = I/O" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="34" width="760" height="20" as="geometry" />
        </mxCell>

        <!-- ===== Sources ===== -->
        <mxCell id="src_xray" value="XRAY (Jira)&#10;GraphQL / REST API · CSV / JSON export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="64" width="250" height="48" as="geometry" />
        </mxCell>
